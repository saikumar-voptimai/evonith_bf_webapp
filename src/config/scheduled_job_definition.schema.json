{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voptimalse:scheduled-job-definition:v1",
  "title": "Scheduled Job Definition v1",
  "description": "Portable, non-sensitive scheduled-job configuration generated by the operator UI. This artifact describes a job but does not represent persistence, activation, revision, synchronization, or execution state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_name",
    "instructions",
    "job_type",
    "analysis_level",
    "schedule",
    "target_device",
    "inputs",
    "delivery",
    "retry",
    "policy_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "scheduled-job-definition/v1"
    },
    "job_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "job_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "analysis_level": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "schedule": {
      "$ref": "#/$defs/schedule"
    },
    "target_device": {
      "$ref": "#/$defs/targetDevice"
    },
    "inputs": {
      "$ref": "#/$defs/jobInputs"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "retry": {
      "$ref": "#/$defs/retry"
    },
    "policy_profile": {
      "const": "bf_operator_read_only_v1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "eta_co_report"
          }
        },
        "required": [
          "job_type"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "required": [
              "furnace",
              "data_source",
              "output_format",
              "signal",
              "report_duration_minutes",
              "aggregation_interval",
              "warning_threshold",
              "critical_threshold",
              "include_graph",
              "include_ai_summary"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "data_period"
                  ]
                },
                {
                  "required": [
                    "data_period_anchor"
                  ]
                },
                {
                  "required": [
                    "lookback"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "inputs": {
            "required": [
              "furnace",
              "data_source",
              "output_format",
              "data_period",
              "data_period_anchor"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "data_period": {
                      "const": "custom_lookback"
                    }
                  },
                  "required": [
                    "data_period"
                  ]
                },
                "then": {
                  "required": [
                    "lookback"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "lookback"
                    ]
                  }
                }
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "signal"
                      ]
                    },
                    {
                      "required": [
                        "report_duration_minutes"
                      ]
                    },
                    {
                      "required": [
                        "aggregation_interval"
                      ]
                    },
                    {
                      "required": [
                        "warning_threshold"
                      ]
                    },
                    {
                      "required": [
                        "critical_threshold"
                      ]
                    },
                    {
                      "required": [
                        "include_graph"
                      ]
                    },
                    {
                      "required": [
                        "include_ai_summary"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "eta_co_report"
          },
          "inputs": {
            "properties": {
              "include_ai_summary": {
                "const": true
              }
            },
            "required": [
              "include_ai_summary"
            ]
          }
        },
        "required": [
          "job_type",
          "inputs"
        ]
      },
      "then": {
        "properties": {
          "analysis_level": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "eta_co_report"
          },
          "inputs": {
            "properties": {
              "include_graph": {
                "const": false
              }
            },
            "required": [
              "include_graph"
            ]
          }
        },
        "required": [
          "job_type",
          "inputs"
        ]
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "attachments": {
                "not": {
                  "contains": {
                    "const": "png"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency",
        "timezone",
        "overlap_policy",
        "misfire_policy",
        "trigger"
      ],
      "properties": {
        "frequency": {
          "enum": [
            "once",
            "hourly",
            "daily",
            "weekdays",
            "selected_days",
            "weekly",
            "monthly",
            "interval_hours",
            "shift_end"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "default": "Asia/Kolkata"
        },
        "overlap_policy": {
          "const": "skip"
        },
        "misfire_policy": {
          "const": "fire_once_latest"
        },
        "trigger": {
          "oneOf": [
            {
              "$ref": "#/$defs/onceTrigger"
            },
            {
              "$ref": "#/$defs/cronTrigger"
            },
            {
              "$ref": "#/$defs/intervalTrigger"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "frequency": {
                "const": "once"
              }
            },
            "required": [
              "frequency"
            ]
          },
          "then": {
            "properties": {
              "trigger": {
                "$ref": "#/$defs/onceTrigger"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "frequency": {
                "const": "interval_hours"
              }
            },
            "required": [
              "frequency"
            ]
          },
          "then": {
            "properties": {
              "trigger": {
                "$ref": "#/$defs/intervalTrigger"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "frequency": {
                "enum": [
                  "hourly",
                  "daily",
                  "weekdays",
                  "selected_days",
                  "weekly",
                  "monthly",
                  "shift_end"
                ]
              }
            },
            "required": [
              "frequency"
            ]
          },
          "then": {
            "properties": {
              "trigger": {
                "$ref": "#/$defs/cronTrigger"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "frequency": {
                "const": "hourly"
              }
            },
            "required": [
              "frequency"
            ]
          },
          "then": {
            "properties": {
              "trigger": {
                "properties": {
                  "expression": {
                    "pattern": "^(?:[0-9]|[1-5][0-9]) \\* \\* \\* \\*$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "frequency": {
                "const": "shift_end"
              }
            },
            "required": [
              "frequency"
            ]
          },
          "then": {
            "properties": {
              "trigger": {
                "required": [
                  "derived_from"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "trigger": {
                "not": {
                  "required": [
                    "derived_from"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "onceTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_at"
      ],
      "properties": {
        "type": {
          "const": "once"
        },
        "run_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "cronTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "expression"
      ],
      "properties": {
        "type": {
          "const": "cron"
        },
        "expression": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^(?:[0-9*/,-]+\\s+){4}[0-9*/,-]+$"
        },
        "derived_from": {
          "$ref": "#/$defs/shiftDerivation"
        }
      }
    },
    "intervalTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "interval_seconds",
        "anchor_at"
      ],
      "properties": {
        "type": {
          "const": "interval"
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 604800,
          "multipleOf": 3600
        },
        "anchor_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "shiftDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "shifts",
        "delay_minutes"
      ],
      "properties": {
        "type": {
          "const": "plant_shift_end"
        },
        "shifts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "end_time"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "end_time": {
                "$ref": "#/$defs/clockTime"
              }
            }
          }
        },
        "delay_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        }
      }
    },
    "clockTime": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "targetDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "device_type"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "device_type": {
          "enum": [
            "vm",
            "jetson",
            "raspberry_pi"
          ]
        }
      }
    },
    "jobInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "furnace": {
          "const": "BF2"
        },
        "data_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "output_format": {
          "enum": [
            "operator_summary",
            "detailed_report",
            "exception_alert"
          ]
        },
        "data_period": {
          "enum": [
            "previous_shift",
            "current_shift",
            "previous_day",
            "last_24_hours",
            "custom_lookback"
          ]
        },
        "data_period_anchor": {
          "const": "scheduled_for"
        },
        "lookback": {
          "$ref": "#/$defs/lookback"
        },
        "signal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "report_duration_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "aggregation_interval": {
          "enum": [
            "1min",
            "5min",
            "15min",
            "30min",
            "1h"
          ]
        },
        "warning_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "critical_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "include_graph": {
          "type": "boolean"
        },
        "include_ai_summary": {
          "type": "boolean"
        }
      }
    },
    "lookback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "enum": [
            "hours",
            "days"
          ]
        }
      }
    },
    "delivery": {
      "oneOf": [
        {
          "$ref": "#/$defs/inAppDelivery"
        },
        {
          "$ref": "#/$defs/emailDelivery"
        },
        {
          "$ref": "#/$defs/messageDelivery"
        }
      ]
    },
    "inAppDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "notify_on_failure",
        "destination_ref"
      ],
      "properties": {
        "channel": {
          "const": "in_app"
        },
        "notify_on_failure": {
          "type": "boolean",
          "default": true
        },
        "destination_ref": {
          "const": "task_owner"
        }
      }
    },
    "emailDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "notify_on_failure",
        "recipients",
        "subject",
        "attachments"
      ],
      "properties": {
        "channel": {
          "const": "email"
        },
        "notify_on_failure": {
          "type": "boolean",
          "default": true
        },
        "recipients": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "attachments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "png",
              "csv",
              "json"
            ]
          }
        }
      }
    },
    "messageDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "notify_on_failure",
        "destination"
      ],
      "properties": {
        "channel": {
          "enum": [
            "whatsapp",
            "telegram"
          ]
        },
        "notify_on_failure": {
          "type": "boolean",
          "default": true
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "const": "whatsapp"
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "properties": {
              "destination": {
                "pattern": "^\\+[1-9][0-9]{7,14}$"
              }
            }
          },
          "else": {
            "properties": {
              "destination": {
                "pattern": "^(?:@?[A-Za-z][A-Za-z0-9_]{4,31}|-?[0-9]{5,20})$"
              }
            }
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_attempts",
        "retry_interval_seconds",
        "timeout_seconds"
      ],
      "properties": {
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "retry_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 60
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400,
          "default": 600
        }
      }
    }
  },
  "$comment": "JSON Schema enforces shape, enums, and scalar ranges. Application validation must additionally trim required strings, resolve the IANA timezone, semantically validate cron fields, enforce ETA critical_threshold < warning_threshold, ensure the aggregation interval does not exceed the report duration, validate recipient uniqueness case-insensitively, and reject credential-like content before serialization."
}
