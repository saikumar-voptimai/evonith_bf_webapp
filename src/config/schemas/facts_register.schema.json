{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BF-02 process fact register",
  "type": "object",
  "required": [
    "name",
    "version",
    "date",
    "statuses",
    "facts",
    "revision_log"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "string"
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "grades": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "revision_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "change"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "change": {
            "type": "string"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "statement",
          "value",
          "status",
          "grade",
          "version",
          "date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(COKE|GAS|FLOW|DATA|BAND|ASM|MOD|VAL)-[0-9]{2}$"
          },
          "group": {
            "enum": [
              "COKE",
              "GAS",
              "FLOW",
              "DATA",
              "BAND",
              "ASM",
              "MOD",
              "VAL"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "se": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "status": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "literature": {
            "type": "string"
          },
          "validity_window": {
            "type": "string"
          },
          "next_test": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "trials": {
      "description": "The register's trial list: the planned BF-02 trials that would settle open facts (client deck 27 Oct 2026, slide 46).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rank",
          "title",
          "change",
          "facts",
          "benefit",
          "design",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(T|TR-)[0-9]+[a-z]?$"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "benefit": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "rs_thm": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "basis": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "design": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Proposed",
              "Planned",
              "Running",
              "Done",
              "Dropped"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "plant": {
            "description": "Plain wording for client pages and FurnaceMind where the deck's text names a model or method.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "benefit": {
                "type": "string"
              },
              "design": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "trial_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
