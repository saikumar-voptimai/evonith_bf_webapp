# InfluxDB tokens
INFLUX_ONLINE_TOKEN=your_influx_online_token_here
INFLUX_OFFLINE_TOKEN=your_influx_offline_token_here

# PostgreSQL (Neon) — for burden distribution data
DATABASE_URL=postgresql://user:password@host/dbname

# Server (optional, defaults shown)
# HOST=0.0.0.0
# PORT=8000
# MAX_RESULT_FILES=3
