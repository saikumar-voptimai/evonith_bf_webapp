# Runtime data directory for generated local files.
# Local development can use ./runtime.
# Edge production should use a persistent directory such as /var/lib/evonith-bf.
# Runtime data must not be committed.
# Do not store secrets in runtime files unless explicitly required and secured.
EVONITH_RUNTIME_DIR=./runtime

# Phase 11 runtime profiles.
# These values describe the intended runtime profile and do not contain secrets.
EVONITH_DEPLOYMENT_PROFILE=local
EVONITH_DEPLOYMENT_ENV=local
EVONITH_DEPLOYMENT_ROLE=single-node
EVONITH_RELEASE_VERSION=
EVONITH_RELEASE_CHANNEL=dev
EVONITH_RUNTIME_PROFILE=local
EVONITH_EDGE_MODE=false
EVONITH_EDGE_DEVICE_TYPE=
EVONITH_BACKEND_PROFILE=backend-base
EVONITH_FRONTEND_PROFILE=frontend

# Phase 13 backup/restore controls.
# Keep backup archives outside source control. Restore defaults to dry-run.
EVONITH_BACKUP_DIR=./runtime/backups
EVONITH_RESTORE_DRY_RUN_DEFAULT=true
EVONITH_BACKUP_INCLUDE_UPLOADS=true
EVONITH_BACKUP_INCLUDE_ARTIFACTS=false
EVONITH_BACKUP_INCLUDE_LOGS=false
EVONITH_BACKUP_INCLUDE_AUDIT=true
EVONITH_BACKUP_MAX_ARCHIVES=10

# Backend/frontend service ports.
# Phase 12 canonical commands:
#   uvicorn apps.backend_api.app.main:app --host 0.0.0.0 --port 8080
#   streamlit run apps/frontend_streamlit/app.py
# Temporary compatibility commands remain available:
#   cd furnace-data-service && uvicorn app.main:app --host 0.0.0.0 --port 8080
#   streamlit run src/app.py
EVONITH_UVICORN_WORKERS=1
EVONITH_UVICORN_HOST=0.0.0.0
EVONITH_UVICORN_PORT=8080
EVONITH_BACKEND_API_URL=http://localhost:8080/api/v1
EVONITH_BACKEND_PUBLIC_URL=http://localhost:8080
EVONITH_BACKEND_HEALTH_URL=http://localhost:8080/api/v1/health
EVONITH_BACKEND_READINESS_URL=http://localhost:8080/api/v1/readiness
EVONITH_FRONTEND_HOST=0.0.0.0
EVONITH_FRONTEND_PORT=8501

# Edge CPU/thread defaults.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# Optional feature availability.
EVONITH_ENABLE_OPTIONAL_AI=false
EVONITH_ENABLE_OPTIONAL_ML=true
EVONITH_ENABLE_OPTIONAL_VECTOR=false
EVONITH_ENABLE_OPTIONAL_DOCUMENTS=true
EVONITH_ENABLE_OPTIONAL_LOCAL_LLM=false

# Phase 2 backend API foundation.
# /api/v1 is the official new backend API prefix.
# Legacy routes remain enabled during migration so Streamlit and older callers keep working.
# Restrict CORS origins in production; do not use wildcard origins by default.
# Do not commit secrets in this file.
EVONITH_API_PREFIX=/api/v1
EVONITH_BACKEND_ENV=local
EVONITH_BACKEND_LOG_LEVEL=INFO
EVONITH_LOG_LEVEL=INFO
EVONITH_LOG_FORMAT=json
EVONITH_ACCESS_LOG_ENABLED=true
EVONITH_ACCESS_LOG_INCLUDE_QUERY_PARAMS=false
EVONITH_LOG_REDACTION_ENABLED=true
EVONITH_LOG_FILE_ENABLED=false
EVONITH_LOG_MAX_FILE_MB=50
EVONITH_LOG_BACKUP_COUNT=5
BACKEND_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173
EVONITH_ENABLE_LEGACY_ROUTES=false
EVONITH_OPENAPI_TITLE=Evonith BF Backend API
EVONITH_OPENAPI_VERSION=0.1.0
EVONITH_OPENAPI_DESCRIPTION=Versioned backend API for Evonith BF web application

# Backend auth/admin API.
# Set EVONITH_AUTH_SECRET_KEY to a strong random value in production.
# The current repository dependency set supports bcrypt; use argon2 only after
# adding argon2-cffi to the runtime image.
EVONITH_AUTH_ENABLED=true
EVONITH_AUTH_SECRET_KEY=
EVONITH_AUTH_ALGORITHM=HS256
EVONITH_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480
EVONITH_AUTH_REQUIRE_SECRET_IN_PRODUCTION=true
EVONITH_AUTH_ALLOW_LEGACY_PASSWORD_HASHES=true
EVONITH_AUTH_UPGRADE_LEGACY_HASH_ON_LOGIN=true
EVONITH_AUTH_PASSWORD_HASH_SCHEME=bcrypt
EVONITH_AUTH_MIN_PASSWORD_LENGTH=8
EVONITH_AUTH_BOOTSTRAP_ADMIN_ENABLED=false

# Optional one-time admin bootstrap inputs.
# Do not commit real credentials.
EVONITH_BOOTSTRAP_ADMIN_USERNAME=
EVONITH_BOOTSTRAP_ADMIN_EMAIL=
EVONITH_BOOTSTRAP_ADMIN_PASSWORD=
EVONITH_BOOTSTRAP_ADMIN_FULL_NAME=

# Frontend -> Backend API.
# Keep USE_BACKEND_API=false during the early migration; most pages still use direct mode.
BACKEND_API_BASE_URL=http://localhost:8080/api/v1
USE_BACKEND_API=false
EVONITH_ALLOW_DIRECT_MODE_FALLBACK=true
EVONITH_CUTOVER_MODE=direct
EVONITH_ROLLBACK_MODE=direct
BACKEND_API_TIMEOUT_SECONDS=30
BACKEND_API_CONNECT_TIMEOUT_SECONDS=5
BACKEND_API_MAX_RETRIES=1
BACKEND_API_VERIFY_SSL=true
SHOW_BACKEND_STATUS_BADGE=true
SHOW_ADVANCED_BACKEND_STATUS=false
BACKEND_API_HEALTH_PATH=/health
BACKEND_API_READINESS_PATH=/readiness

# Page-specific API migration flags; keep false during early migration.
USE_BACKEND_API_AUTH=true
USE_BACKEND_API_ADMIN=false
USE_BACKEND_API_WELCOME=false
USE_BACKEND_API_DATA_EXPLORER=true
USE_BACKEND_API_DATASETS=false
USE_BACKEND_API_FEEDBACK=false
# Phase 7 frontend domain-compute API migration flags.
USE_BACKEND_API_MATERIAL_BALANCE=false
USE_BACKEND_API_RECOMMENDATIONS=false
USE_BACKEND_API_BLEND_OPTIMIZER=false
# Phase 8 frontend AI Copilot API migration flag.
USE_BACKEND_API_COPILOT=false
# Phase 9 frontend FurnaceMind API migration flag.
USE_BACKEND_API_FURNACEMIND=false
# Phase 10 frontend operations/status flags.
USE_BACKEND_API_OPS=false

# Phase 10 backend operational hardening.
# Detailed status, metrics, cleanup, audit, and job endpoints are admin-protected by default.
# Do not expose admin tokens or production secrets in logs, audit events, metrics, or docs.
EVONITH_AUDIT_LOG_ENABLED=true
EVONITH_AUDIT_STORAGE_BACKEND=sqlite
EVONITH_AUDIT_DATABASE_URL=
EVONITH_AUDIT_RETENTION_DAYS=90
EVONITH_AUDIT_ADMIN_READ_ENABLED=true
EVONITH_STATUS_PUBLIC_HEALTH=true
EVONITH_STATUS_REQUIRE_AUTH_FOR_DETAILS=true
EVONITH_DEPENDENCY_CHECK_TIMEOUT_SECONDS=3
EVONITH_DEPENDENCY_CHECK_CACHE_SECONDS=30
EVONITH_RUNTIME_MIN_FREE_MB=1024
EVONITH_RUNTIME_WARN_FREE_MB=4096
EVONITH_METRICS_ENABLED=true
EVONITH_METRICS_REQUIRE_AUTH=true
EVONITH_METRICS_FORMAT=json
EVONITH_METRICS_RESET_ENABLED=false
EVONITH_UNIFIED_JOBS_ENABLED=true
EVONITH_CLEANUP_ENABLED=true
EVONITH_CLEANUP_DRY_RUN_DEFAULT=true
EVONITH_CLEANUP_REQUIRE_ADMIN=true
EVONITH_CLEANUP_MAX_DELETE_PER_RUN=500
EVONITH_CLEANUP_INCLUDE_LOGS=false
EVONITH_CLEANUP_INCLUDE_UPLOADS=false
EVONITH_CLEANUP_JOB_TTL_HOURS=24
EVONITH_CLEANUP_ARTIFACT_TTL_HOURS=24
EVONITH_CLEANUP_TEMP_TTL_HOURS=6

# Phase 6 backend Feedback/Tickets API.
# SQLite stores metadata only; attachment bytes stay under EVONITH_RUNTIME_DIR/uploads/feedback.
# Do not store secrets in ticket metadata or uploaded runtime files.
EVONITH_FEEDBACK_REQUIRE_AUTH=true
EVONITH_FEEDBACK_STORAGE_BACKEND=sqlite
EVONITH_FEEDBACK_DATABASE_URL=
EVONITH_FEEDBACK_MAX_ATTACHMENT_MB=10
EVONITH_FEEDBACK_ALLOWED_ATTACHMENT_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain,text/csv
EVONITH_FEEDBACK_ALLOWED_ATTACHMENT_EXTENSIONS=.png,.jpg,.jpeg,.webp,.pdf,.txt,.csv
EVONITH_FEEDBACK_MAX_ATTACHMENTS_PER_TICKET=10
EVONITH_FEEDBACK_DEFAULT_STATUS=open
EVONITH_FEEDBACK_ALLOWED_STATUSES=open,in_progress,resolved,closed,rejected
EVONITH_FEEDBACK_ALLOWED_PRIORITIES=low,medium,high,critical
EVONITH_FEEDBACK_TICKET_ID_PREFIX=FB
EVONITH_FEEDBACK_ENABLE_LEGACY_READ_FALLBACK=true

# Data Explorer API limits. Preview rows are bounded; exports are generated
# server-side from the original typed query and require Idempotency-Key.
DATA_PREVIEW_MAX_ROWS=500
DATA_MAX_SELECTED_FIELDS=20
DATA_EXPORT_TTL_HOURS=24
DATA_EXPORT_MAX_ROWS=100000
HOT_METAL_SLAG_MAX_PREVIEW_DAYS=31
HOT_METAL_SLAG_MAX_INTERVAL_MINUTES=600
DATASET_JOB_TTL_HOURS=24
DATASET_JOB_WORKERS=1
DATASET_MAX_BUILD_RANGE_DAYS=366

# Legacy compatibility aliases (prefer the names above for new deployments).
DATA_API_MAX_PREVIEW_ROWS=500
DATA_API_MAX_JSON_ROWS=5000
DATA_API_EXPORT_FORMAT=csv
DATA_API_JOB_TTL_HOURS=24
DATA_API_ARTIFACT_TTL_HOURS=24

# Backend compute settings.
EVONITH_COMPUTE_REQUIRE_AUTH=true
EVONITH_COMPUTE_MAX_PREVIEW_ROWS=500
EVONITH_COMPUTE_MAX_JSON_ROWS=5000
EVONITH_COMPUTE_MAX_INPUT_ROWS=50000
EVONITH_COMPUTE_JOB_THRESHOLD_ROWS=5000
EVONITH_COMPUTE_JOB_TTL_HOURS=24
EVONITH_COMPUTE_ARTIFACT_TTL_HOURS=24
EVONITH_COMPUTE_MAX_SECONDS=180
EVONITH_COMPUTE_THREADPOOL_WORKERS=1
EVONITH_COMPUTE_EXPORT_FORMAT=csv

# Model registry settings.
# Edge production should set EVONITH_MODEL_DIR explicitly when models are required.
EVONITH_MODEL_DIR=
EVONITH_MODEL_LAZY_LOAD=true
EVONITH_MODEL_CACHE_MAX_ITEMS=2
EVONITH_MODEL_LOAD_TIMEOUT_SECONDS=30
EVONITH_MODEL_ALLOW_MISSING_OPTIONAL_MODELS=true

# Material Balance settings.
EVONITH_MATERIAL_BALANCE_CONFIG_SOURCE=file
EVONITH_MATERIAL_BALANCE_ALLOW_RUNTIME_CONFIG=false

# Recommendations settings.
EVONITH_RECOMMENDATIONS_ENABLE_EXPLANATIONS=true
EVONITH_RECOMMENDATIONS_MAX_ITEMS=50

# Blend Optimizer settings.
EVONITH_BLEND_OPTIMIZER_MAX_CANDIDATES=100
EVONITH_BLEND_OPTIMIZER_MAX_ITERATIONS=1000
EVONITH_BLEND_OPTIMIZER_TIMEOUT_SECONDS=120
EVONITH_BLEND_OPTIMIZER_ENABLE_MODEL_PREDICTIONS=true

# Backend AI Copilot settings.
# Provider mode is optional. Store real provider keys only in secure environment
# variables outside git; EVONITH_COPILOT_API_KEY_ENV names the env var to read.
EVONITH_COPILOT_REQUIRE_AUTH=true
EVONITH_COPILOT_LLM_ENABLED=false
EVONITH_COPILOT_PROVIDER=
EVONITH_COPILOT_MODEL=
EVONITH_COPILOT_API_KEY_ENV=OPENAI_API_KEY
EVONITH_COPILOT_TIMEOUT_SECONDS=60
EVONITH_COPILOT_MAX_SECONDS=120
EVONITH_COPILOT_MAX_CONTEXT_ROWS=1000
EVONITH_COPILOT_MAX_JSON_ROWS=5000
EVONITH_COPILOT_MAX_PROMPT_CHARS=20000
EVONITH_COPILOT_MAX_OUTPUT_CHARS=8000
EVONITH_COPILOT_JOB_THRESHOLD_ROWS=1000
EVONITH_COPILOT_JOB_TTL_HOURS=24
EVONITH_COPILOT_ARTIFACT_TTL_HOURS=24
EVONITH_COPILOT_ENABLE_DATA_REDACTION=true
EVONITH_COPILOT_ALLOW_RAW_DATA_TO_LLM=false
EVONITH_COPILOT_ENABLE_PROVIDER_CALLS=false
EVONITH_COPILOT_ENABLE_CODE_EXECUTION=false
EVONITH_COPILOT_ENABLE_PLOTS=true
EVONITH_COPILOT_LOG_PROMPT_PREVIEW=false

# Backend FurnaceMind settings.
# Provider and vector API keys must be stored only in secure environment
# variables outside git. *_API_KEY_ENV values name the secret env var to read.
EVONITH_FURNACEMIND_REQUIRE_AUTH=true
EVONITH_FURNACEMIND_STORAGE_BACKEND=sqlite
EVONITH_FURNACEMIND_DATABASE_URL=
EVONITH_FURNACEMIND_LLM_ENABLED=false
EVONITH_FURNACEMIND_PROVIDER=
EVONITH_FURNACEMIND_MODEL=
EVONITH_FURNACEMIND_API_KEY_ENV=OPENAI_API_KEY
EVONITH_FURNACEMIND_ENABLE_PROVIDER_CALLS=false
EVONITH_FURNACEMIND_TIMEOUT_SECONDS=120
EVONITH_FURNACEMIND_MAX_MESSAGE_CHARS=8000
EVONITH_FURNACEMIND_MAX_RESPONSE_CHARS=12000
EVONITH_FURNACEMIND_MAX_PROMPT_CHARS=30000
EVONITH_FURNACEMIND_MAX_HISTORY_MESSAGES=20
EVONITH_FURNACEMIND_MAX_CONTEXT_DOCS=5
EVONITH_FURNACEMIND_MAX_CONTEXT_CHARS=20000
EVONITH_FURNACEMIND_ENABLE_DATA_REDACTION=true
EVONITH_FURNACEMIND_ALLOW_RAW_DOCS_TO_LLM=false
EVONITH_FURNACEMIND_LOG_PROMPT_PREVIEW=false

# FurnaceMind document settings.
EVONITH_FURNACEMIND_DOCUMENTS_ENABLED=true
EVONITH_FURNACEMIND_MAX_DOCUMENT_MB=20
EVONITH_FURNACEMIND_ALLOWED_DOCUMENT_TYPES=application/pdf,text/plain,text/markdown,text/csv,application/json
EVONITH_FURNACEMIND_ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.txt,.md,.csv,.json
EVONITH_FURNACEMIND_MAX_EXTRACTED_CHARS=200000
EVONITH_FURNACEMIND_DOCUMENT_TTL_DAYS=0

# FurnaceMind memory/vector settings.
EVONITH_FURNACEMIND_MEMORY_ENABLED=false
EVONITH_FURNACEMIND_VECTOR_BACKEND=qdrant
EVONITH_FURNACEMIND_QDRANT_URL=
EVONITH_FURNACEMIND_QDRANT_API_KEY_ENV=QDRANT_API_KEY
EVONITH_FURNACEMIND_QDRANT_COLLECTION=evonith_furnacemind
EVONITH_FURNACEMIND_EMBEDDINGS_ENABLED=false
EVONITH_FURNACEMIND_EMBEDDING_PROVIDER=
EVONITH_FURNACEMIND_EMBEDDING_MODEL=
EVONITH_FURNACEMIND_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
EVONITH_FURNACEMIND_VECTOR_TOP_K=5
EVONITH_FURNACEMIND_VECTOR_TIMEOUT_SECONDS=10

# FurnaceMind tools.
EVONITH_FURNACEMIND_TOOLS_ENABLED=false
EVONITH_FURNACEMIND_ALLOWED_TOOLS=data_summary,anomaly_summary,material_balance_summary,recommendations_summary,blend_optimizer_summary
EVONITH_FURNACEMIND_TOOL_TIMEOUT_SECONDS=30
EVONITH_FURNACEMIND_MAX_TOOL_CALLS_PER_RUN=5
EVONITH_FURNACEMIND_ENABLE_CODE_EXECUTION=false
EVONITH_FURNACEMIND_ENABLE_SHELL_EXECUTION=false

# FurnaceMind runs/events/artifacts.
EVONITH_FURNACEMIND_RUN_TTL_HOURS=24
EVONITH_FURNACEMIND_ARTIFACT_TTL_HOURS=24
EVONITH_FURNACEMIND_EVENT_RETENTION_HOURS=24
EVONITH_FURNACEMIND_MAX_EVENTS_PER_RUN=500
EVONITH_FURNACEMIND_STREAMING_ENABLED=true
EVONITH_FURNACEMIND_POLLING_FALLBACK_ENABLED=true
