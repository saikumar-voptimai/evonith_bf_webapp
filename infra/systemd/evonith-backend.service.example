[Unit]
Description=Evonith BF backend API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=evonith
Group=evonith
WorkingDirectory=/opt/evonith-bf
EnvironmentFile=/etc/evonith-bf/backend.env
ExecStart=/opt/evonith-bf/scripts/edge_start_backend.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evonith-bf

[Install]
WantedBy=multi-user.target
