# Evonith BF generic ARM64 edge template.
# Use placeholders only here; set real secrets in a protected environment file.
# Prefer edge.jetson.env.example or edge.raspberry-pi.env.example on known hardware.

EVONITH_DEPLOYMENT_PROFILE=edge
EVONITH_DEPLOYMENT_ENV=edge
EVONITH_DEPLOYMENT_ROLE=single-node
EVONITH_RELEASE_VERSION=
EVONITH_RELEASE_CHANNEL=edge
EVONITH_BACKEND_ENV=production
EVONITH_RUNTIME_PROFILE=edge

EVONITH_RUNTIME_DIR=/var/lib/evonith-bf
EVONITH_BACKUP_DIR=/var/lib/evonith-bf/backups
EVONITH_EDGE_MODE=true
EVONITH_EDGE_DEVICE_TYPE=generic-arm64

EVONITH_UVICORN_HOST=127.0.0.1
EVONITH_UVICORN_PORT=1432
EVONITH_UVICORN_WORKERS=1
EVONITH_UVICORN_BIN=/opt/evonith-bf/.venv/bin/uvicorn
EVONITH_FRONTEND_HOST=0.0.0.0
EVONITH_FRONTEND_PORT=8501
BACKEND_API_BASE_URL=http://127.0.0.1:1432/api/v1

# Keep automatic CPU fallback during initial deployment. Set CUDA_REQUIRED=true
# only after scripts/verify_jetson_cuda.py succeeds on the device.
EVONITH_ML_DEVICE=auto
EVONITH_XGBOOST_DEVICE=auto
EVONITH_CUDA_REQUIRED=false

EVONITH_AUTH_SECRET_KEY=<set-a-strong-random-secret>
EVONITH_AUTH_ENABLED=true
EVONITH_AUTH_REQUIRE_SECRET_IN_PRODUCTION=true
EVONITH_BACKEND_PROFILE=backend-base
EVONITH_FRONTEND_PROFILE=frontend

USE_BACKEND_API=true
USE_BACKEND_API_AUTH=true
USE_BACKEND_API_ADMIN=true
USE_BACKEND_API_DATA_EXPLORER=true
USE_BACKEND_API_DATASETS=true
USE_BACKEND_API_FEEDBACK=true
USE_BACKEND_API_MATERIAL_BALANCE=true
USE_BACKEND_API_RECOMMENDATIONS=true
USE_BACKEND_API_BLEND_OPTIMIZER=true
USE_BACKEND_API_COPILOT=true
USE_BACKEND_API_FURNACEMIND=true
USE_BACKEND_API_OPS=true
USE_BACKEND_API_VBOARD=true
EVONITH_ALLOW_DIRECT_MODE_FALLBACK=true
EVONITH_CUTOVER_MODE=api
EVONITH_ROLLBACK_MODE=direct

OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
TOKENIZERS_PARALLELISM=false
MALLOC_ARENA_MAX=2

EVONITH_ENABLE_OPTIONAL_AI=false
EVONITH_ENABLE_OPTIONAL_VECTOR=false
EVONITH_ENABLE_OPTIONAL_LOCAL_LLM=false
OPENAI_API_KEY=<optional-set-outside-git>
QDRANT_API_KEY=<optional-set-outside-git>
