# Evonith BF frontend environment template.
# Copy to a secure location such as /etc/evonith-bf/frontend.env.

EVONITH_DEPLOYMENT_PROFILE=production
EVONITH_DEPLOYMENT_ENV=production
EVONITH_DEPLOYMENT_ROLE=frontend
EVONITH_RELEASE_VERSION=
EVONITH_RELEASE_CHANNEL=stable

EVONITH_RUNTIME_DIR=/var/lib/evonith-bf
EVONITH_FRONTEND_HOST=0.0.0.0
EVONITH_FRONTEND_PORT=8501
# For separately hosted Streamlit, use the TLS API hostname exposed by the
# Jetson reverse proxy, for example https://api.example.com/api/v1.
BACKEND_API_BASE_URL=http://localhost:8080/api/v1
BACKEND_API_VERIFY_SSL=true
BACKEND_API_CONNECT_TIMEOUT_SECONDS=5
BACKEND_API_TIMEOUT_SECONDS=60
BACKEND_API_MAX_RETRIES=2

USE_BACKEND_API=true
USE_BACKEND_API_AUTH=true
USE_BACKEND_API_ADMIN=true
USE_BACKEND_API_DATA_EXPLORER=true
USE_BACKEND_API_DATASETS=true
USE_BACKEND_API_FEEDBACK=true
USE_BACKEND_API_MATERIAL_BALANCE=true
USE_BACKEND_API_RECOMMENDATIONS=true
USE_BACKEND_API_BLEND_OPTIMIZER=true
USE_BACKEND_API_COPILOT=true
USE_BACKEND_API_FURNACEMIND=true
USE_BACKEND_API_OPS=true

EVONITH_ALLOW_DIRECT_MODE_FALLBACK=true
EVONITH_CUTOVER_MODE=api
EVONITH_ROLLBACK_MODE=direct

SHOW_BACKEND_STATUS_BADGE=true
SHOW_ADVANCED_BACKEND_STATUS=false
